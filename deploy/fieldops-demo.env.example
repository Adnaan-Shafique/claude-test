# Copy to /etc/fieldops-demo.env and chmod 600. NEVER commit the real file -
# it holds the proxy API key.
#
#   sudo install -m 600 /dev/null /etc/fieldops-demo.env
#   sudo vi /etc/fieldops-demo.env

# Reach the model through llm_proxy_v3 on FALCONPRD rather than the GPU server,
# which this VM cannot see. See PROXY.md.
FIELDOPS_VLM_TRANSPORT=proxy
FIELDOPS_GPU_URL=http://10.19.71.246:8071

# The proxy reported auth_enabled=True, so this is required. Match it to one of
# the client:secret pairs the proxy was started with.
FIELDOPS_VLM_API_KEY=secret-falcon1

# Optional - the app defaults to qwen3-vl.
# FIELDOPS_VLM_MODEL=qwen3-vl
