# Copy to /etc/ippms-assistant/ippms.env, fill in the real values, then:
#   chown root:ippms /etc/ippms-assistant/ippms.env
#   chmod 640        /etc/ippms-assistant/ippms.env
#
# systemd EnvironmentFile format — NOT a shell script:
#   - no `export`
#   - no command substitution or variable expansion
#   - quote only if the value contains spaces
#   - a literal # starts a comment, so avoid # inside unquoted values

# ── Instant Graph API ────────────────────────────────────────────────────────
INSTANT_GRAPH_BASE_URL=https://10.34.64.74:5001/api/api
# The gateway's cert is self-signed and is verified against this PEM, and the
# cert's SAN is a DNS name while the URL above connects by IP — both settings
# are needed or every API call fails TLS verification.
IG_CA_BUNDLE=/srv/ippms-assistant/ig_selfsigned.pem
IG_CERT_HOSTNAME=ippms.vodafoneidea.com

# ── Postgres (token store, chat logging, history, glossary) ──────────────────
IG_DB_HOST=10.19.75.115
IG_DB_PORT=5432
IG_DB_NAME=conv_ai_db
IG_DB_USER=ig_app_user
IG_DB_SCHEMA=tt_vi_ippms_schema
# Both apps read this. Set it here so the hardcoded fallback in the source is
# never the thing actually used (see deploy/README.md — that fallback should
# be deleted from both files).
IG_DB_PASSWORD=CHANGE_ME
VI_DB_PASSWORD=CHANGE_ME

# ── MCP server (ippms-mcp.service) ───────────────────────────────────────────
# Bind to loopback: only the chat app on this host needs to reach the MCP
# server, and it exposes the Instant Graph tools with no auth of its own.
MCP_HOST=127.0.0.1
MCP_PORT=8056
# The MCP server's own Dash ops console. Loopback too — reach it with an SSH
# tunnel when you need it rather than exposing it.
DASH_HOST=127.0.0.1
DASH_PORT=8060

# ── Chat app (ippms-app.service) ─────────────────────────────────────────────
MCP_SERVER_URL=http://127.0.0.1:8056/mcp
GPU_PROXY_URL=http://127.0.0.1:8071/v1/infer
GPU_API_KEY=CHANGE_ME
VI_APP_HOST=0.0.0.0
VI_APP_PORT=8079

# Bundled next to the app; set explicitly so they resolve regardless of cwd.
VI_TOOL_KB_PATH=/srv/ippms-assistant/vi_ippms_tool_kb.md
VI_QUESTION_GUIDE_PATH=/srv/ippms-assistant/vi_ippms_question_guide.xlsx

# ── Optional tuning ──────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# VI_DEBUG=1
# VI_CHAT_HISTORY_RETENTION_DAYS=7
# IG_TOKEN_REFRESH_BUFFER=120
