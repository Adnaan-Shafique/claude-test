[Unit]
Description=Instant Graph MCP server (VI-IPPMS agent tools + ops console)
After=network-online.target
Wants=network-online.target
# Keep restarting forever. systemd's default rate limit (5 starts in 10s, then
# give up and sit in "failed") is the usual reason a service that was supposed
# to self-heal is found dead the next morning — e.g. Postgres or the Instant
# Graph gateway being slow to come back after a reboot means the first few
# starts fail, systemd hits the limit, and then nothing ever retries.
StartLimitIntervalSec=0
# RHEL 7 only (systemd 219): these two live in [Service] and are named
# StartLimitInterval / StartLimitBurst instead. RHEL 8/9 use the above.

[Service]
Type=simple
User=ippms
Group=ippms
WorkingDirectory=/srv/ippms-assistant

# Secrets live here, NOT in this unit file — unit files are world-readable.
# chmod 600, chown ippms:ippms.
EnvironmentFile=/etc/ippms-assistant/ippms.env
Environment=PYTHONUNBUFFERED=1

ExecStart=/srv/ippms-assistant/venv/bin/python /srv/ippms-assistant/instant_graph_mcp_server_v2_4_1.py

Restart=always
RestartSec=5s
TimeoutStopSec=20s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ippms-mcp

# Modest hardening. Drop any of these if they get in the way — none is
# required for the service to work.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
